# =====================================================================================
#  Cấu hình môi trường cho CẢ HAI bot trong repo. Cách dùng:
#      cp .env.example .env      rồi sửa giá trị trong .env (file .env KHÔNG được commit)
#  Chi tiết từng biến + cách lấy Telegram token/chat id: xem HUONG_DAN.md, mục "Biến môi trường".
#  Dòng bắt đầu bằng # là ghi chú / biến đang tắt. Bỏ # để bật.
# =====================================================================================

# ---------------------------------------------------------------- DÙNG CHUNG (cả 2 bot)
# Bắt buộc nếu muốn nhận cảnh báo Telegram (thiếu -> bot vẫn chạy, chỉ ghi log + dashboard)
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=1234567890

# Bật các nút thao tác trên dashboard (Quét/Chạy job, Test Telegram, Reset cầu dao).
# Không đặt = các nút này bị khoá (an toàn mặc định). Swing bot ưu tiên SWING_ADMIN_KEY nếu có.
# ADMIN_KEY=doi-thanh-chuoi-bi-mat-dai

# ---------------------------------------------------------------- SWING BOT (swing/, R3 + Breakout, spot, khung ngày)
# Key riêng cho dashboard swing (nếu muốn khác ADMIN_KEY của bot EMA)
# SWING_ADMIN_KEY=doi-thanh-chuoi-bi-mat-khac

# Gửi cảnh báo swing sang bot/nhóm Telegram KHÁC bot EMA (bỏ trống = dùng TELEGRAM_TOKEN/CHAT_ID ở trên)
# SWING_TELEGRAM_TOKEN=
# SWING_TELEGRAM_CHAT_ID=

# Vốn của sổ giả lập (mặc định lấy từ swing/config.json = 100). Phải >= ~65$ (mỗi lệnh = vốn/12 >= 5$).
# Đổi vốn sau khi bot đã chạy KHÔNG tự áp dụng — phải xoá swing/data để bắt đầu sổ mới.
# SWING_CAPITAL=100

# Dashboard swing: mặc định 127.0.0.1:3100 (chỉ xem trên máy này). 0.0.0.0 = cho máy khác trong mạng xem.
# SWING_HOST=127.0.0.1
# SWING_PORT=3100

# Thư mục dữ liệu (sổ, lịch sử lệnh, sổ tín hiệu). Mặc định swing/data. Nên đặt ngoài repo nếu hay git pull.
# SWING_DATA_DIR=/home/ban/swing-data

# Chỉ dùng khi test với máy chủ giả (để trống khi chạy thật)
# SWING_BINANCE_BASE=https://data-api.binance.vision
# SWING_WS_BASE=wss://data-stream.binance.vision

# ---------------------------------------------------------------- BOT EMA SCALPING (src/, BTC futures 3m/5m)
# Cổng web/dashboard (Render/Koyeb tự cấp). Mặc định 3000.
# PORT=3000
# URL công khai để bot tự ping giữ thức (Render tự có RENDER_EXTERNAL_URL, không cần đặt)
# APP_URL=https://ten-app.onrender.com
# Nguồn nến REST: mặc định chỉ futures. Không nên thêm spot (lệch giá 30–50$ so với futures).
# BINANCE_SOURCE=futures
# Timeout mỗi request REST (ms), mặc định 10000
# BINANCE_TIMEOUT_MS=10000
