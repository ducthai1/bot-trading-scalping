{
  "name": "btc-ema-ribbon-alert",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EMA Ribbon Pullback Scalping alert bot (BTCUSDT Binance Futures -> Telegram)",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "dry": "node --env-file-if-exists=.env src/main.js --dry",
    "test": "node --test 'test/**/*.js'",
    "test:tele": "node --env-file-if-exists=.env src/test-tele.js",
    "backtest": "node src/backtest.js",
    "swing": "node swing/src/main.js",
    "swing:dry": "node swing/src/main.js --dry",
    "swing:once": "node swing/src/main.js --once --dry",
    "swing:backtest": "node swing/src/backtest.js",
    "test:swing": "node --test swing/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pm2": "^7.1.2",
    "ws": "^8.22.1"
  }
}
